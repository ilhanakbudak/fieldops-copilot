# ---------------------------------------------------------------------------
# FieldOps Copilot
# Copy to .env. Everything has a working default in demo mode.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Runs against synthetic documents and a local vector store, so the repository
# is usable with no accounts at all.
DEMO_MODE=true

# --- Supabase ---------------------------------------------------------------
# Postgres + pgvector, storage for source PDFs, and row-level security.
# Leave unset in demo mode; the service falls back to a local SQLite file and a
# sqlite-vec store, so the repository runs with no accounts at all.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Paste the connection string as the dashboard gives it to you — the postgresql://
# prefix is rewritten to the async driver at boot. Connect as an ordinary role,
# not a superuser: a superuser bypasses row-level security even with FORCE.
DATABASE_URL=

# --- Models -----------------------------------------------------------------
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.6-terra

# local  — ONNX embeddings on this machine. Ingesting a 400-page manual is free.
# openai — text-embedding-3-small.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Both providers are configured to produce this width — the local model is
# natively 384, and OpenAI's is asked for 384 via its `dimensions` parameter —
# so the schema does not change when a deployment switches between them.
# Changing this number means a migration and a full re-index.
EMBEDDING_DIM=384

# --- Sessions ---------------------------------------------------------------
# The idle window slides as a session is used; the absolute ceiling does not, so
# a stolen cookie expires whether or not it keeps being used.
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=336

# Failed logins are counted per email and per client address.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Password hashing -------------------------------------------------------
# OWASP's recommended Argon2id parameters. Raise them as hardware improves:
# each account is re-hashed at its next login.
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=19456
ARGON2_PARALLELISM=1

# --- Web --------------------------------------------------------------------
API_URL=http://localhost:8000

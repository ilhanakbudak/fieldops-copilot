# ---------------------------------------------------------------------------
# FieldOps Copilot
# Copy to .env. Everything has a working default in demo mode.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Runs against synthetic documents and a local vector store, so the repository
# is usable with no accounts at all.
DEMO_MODE=true

# --- Supabase ---------------------------------------------------------------
# Postgres + pgvector, auth, storage for source PDFs, and row-level security.
# Leave unset in demo mode; the service falls back to a local sqlite-vec store.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# --- Models -----------------------------------------------------------------
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.6-terra

# local  — ONNX embeddings on this machine. Ingesting a 400-page manual is free.
# openai — text-embedding-3-small.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Web --------------------------------------------------------------------
API_URL=http://localhost:8000

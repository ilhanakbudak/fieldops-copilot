# ---------------------------------------------------------------------------
# FieldOps Copilot
# Copy to .env. Everything has a working default in demo mode.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Runs against synthetic documents and a local vector store, so the repository
# is usable with no accounts at all.
DEMO_MODE=true

# --- Supabase ---------------------------------------------------------------
# Postgres + pgvector, storage for source PDFs, and row-level security.
# Leave unset in demo mode; the service falls back to a local SQLite file with an
# exact brute-force vector search, so the repository runs with no accounts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Paste the connection string as the dashboard gives it to you — the postgresql://
# prefix is rewritten to the async driver at boot. Connect as an ordinary role,
# not a superuser: a superuser bypasses row-level security even with FORCE.
DATABASE_URL=

# --- Models -----------------------------------------------------------------
OPENAI_API_KEY=

# mock   — answers extractively from the retrieved passages, with no model and
#          no credentials. Demonstrates the pipeline; it is not a language
#          model, and the README says so.
# openai — the real thing.
LLM_PROVIDER=mock

# Two tiers. Query rewriting and intent classification are short and forgiving;
# paying the answer model to do them is most of a naive RAG system's bill.
CHAT_MODEL=gpt-5.6-terra
CHEAP_MODEL=gpt-5.6-luna

# local   — ONNX embeddings on this machine. Ingesting a 400-page manual is free,
#           and the corpus never leaves the deployment. Downloads ~130 MB once.
# openai  — text-embedding-3-small.
# hashing — a deterministic stand-in used by the test suite. Not a semantic
#           model; never select it in production.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Both providers are configured to produce this width — the local model is
# natively 384, and OpenAI's is asked for 384 via its `dimensions` parameter —
# so the schema does not change when a deployment switches between them.
# Changing this number means a migration and a full re-index.
EMBEDDING_DIM=384

# --- Ingestion --------------------------------------------------------------
# pdfplumber is MIT and the default. pymupdf is markedly faster and AGPL-3.0, so
# it is an opt-in extra rather than a dependency this repository imposes:
#   uv sync --extra pymupdf
PDF_EXTRACTOR=pdfplumber

# Scanned pages carry no text layer. "none" reports them as empty rather than
# ingesting a blank page as if it were real. "paddle" needs the OCR extra:
#   uv sync --extra ocr
OCR_PROVIDER=none
OCR_MIN_CHARS_PER_PAGE=96

# Retrieval matches the small chunk; the prompt receives the parent section.
CHUNK_CHARS=900
CHUNK_OVERLAP_CHARS=150
PARENT_CHARS=3200

MAX_UPLOAD_BYTES=41943040

# --- Retrieval --------------------------------------------------------------
# Candidates from each leg of the hybrid search, before fusion. Rank fusion can
# only reorder what it was given.
RETRIEVAL_CANDIDATES=40
# Passages that survive reranking and reach the prompt.
RETRIEVAL_TOP_K=6
# Hard ceiling on retrieved context, in characters. The cheapest token is the
# one not sent.
CONTEXT_CHAR_BUDGET=12000

# cross-encoder — a local ONNX reranker. The largest single quality gain in the
#                 pipeline, and a ~90 MB download on first use.
# lexical       — deterministic term overlap; what the test suite uses.
# none          — trust rank fusion alone.
RERANK_PROVIDER=cross-encoder

# --- Sessions ---------------------------------------------------------------
# The idle window slides as a session is used; the absolute ceiling does not, so
# a stolen cookie expires whether or not it keeps being used.
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=336

# Failed logins are counted per email and per client address.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Password hashing -------------------------------------------------------
# OWASP's recommended Argon2id parameters. Raise them as hardware improves:
# each account is re-hashed at its next login.
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=19456
ARGON2_PARALLELISM=1

# --- Web --------------------------------------------------------------------
API_URL=http://localhost:8000
